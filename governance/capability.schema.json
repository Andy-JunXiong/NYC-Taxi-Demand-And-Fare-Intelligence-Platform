{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgov.dev/schemas/ai-capability-v1.json",
  "title": "AI Capability Manifest",
  "description": "Portable governance metadata for deterministic, model, prompt, or hybrid AI capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "name",
    "version",
    "purpose",
    "capability_type",
    "implementation_mode",
    "decision_authority",
    "autonomy_level",
    "task_type",
    "triggers",
    "not_for",
    "contracts",
    "called_by",
    "owner",
    "risk_level",
    "human_review",
    "evaluation",
    "provenance"
  ],
  "properties": {
    "contract": {"const": "agentgov.ai-capability"},
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+(?:\\.[0-9]+){0,2}(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "purpose": {"type": "string", "minLength": 10},
    "capability_type": {
      "enum": [
        "decision_support",
        "evaluation_judge",
        "ml_inference",
        "operator_guidance",
        "content_generation",
        "data_transformation"
      ]
    },
    "implementation_mode": {
      "enum": ["deterministic", "model", "prompt", "hybrid"]
    },
    "decision_authority": {
      "enum": [
        "inform",
        "recommend",
        "assess_claim",
        "publish_bounded_output",
        "execute_bounded_action"
      ]
    },
    "autonomy_level": {
      "enum": [
        "advisory_only",
        "human_approval_required",
        "deterministic_gate",
        "bounded_autonomous"
      ]
    },
    "task_type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
    },
    "triggers": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "not_for": {"$ref": "#/$defs/uniqueStrings"},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_schema", "output_schema"],
      "properties": {
        "input_schema": {"$ref": "#/$defs/schemaReference"},
        "output_schema": {"$ref": "#/$defs/schemaReference"}
      }
    },
    "called_by": {"$ref": "#/$defs/uniqueStrings"},
    "owner": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "stages"],
      "properties": {
        "required": {"type": "boolean"},
        "stages": {"$ref": "#/$defs/uniqueStrings"},
        "reason": {"type": "string", "minLength": 10}
      },
      "allOf": [
        {
          "if": {
            "properties": {"required": {"const": true}},
            "required": ["required"]
          },
          "then": {
            "required": ["reason"],
            "properties": {"stages": {"minItems": 1}}
          },
          "else": {"properties": {"stages": {"maxItems": 0}}}
        }
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "evidence_refs"],
      "properties": {
        "readiness": {
          "enum": [
            "not_configured",
            "schema_only",
            "needs_seed_cases",
            "baseline_ready",
            "regression_ready"
          ]
        },
        "evidence_refs": {"$ref": "#/$defs/uniqueStrings"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "readiness": {"enum": ["baseline_ready", "regression_ready"]}
            },
            "required": ["readiness"]
          },
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "source_refs"],
      "properties": {
        "origin": {"enum": ["authored", "extracted", "generated"]},
        "source_refs": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "source_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"risk_level": {"enum": ["high", "critical"]}},
        "required": ["risk_level"]
      },
      "then": {
        "properties": {
          "human_review": {
            "properties": {"required": {"const": true}}
          }
        }
      }
    },
    {
      "not": {
        "properties": {
          "risk_level": {"enum": ["high", "critical"]},
          "decision_authority": {"const": "execute_bounded_action"},
          "autonomy_level": {"const": "bounded_autonomous"}
        },
        "required": ["risk_level", "decision_authority", "autonomy_level"]
      }
    }
  ],
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "schemaReference": {
      "type": "string",
      "pattern": "^[^\\s]+\\.json(?:#.*)?$"
    }
  }
}
